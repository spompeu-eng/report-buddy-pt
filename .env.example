# Lovable Cloud / Supabase configuration
# Fill these values with your own Lovable Cloud or Supabase project credentials.
# Never commit the real .env file to version control.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side privileged client (only used in server functions/routes).
# This value is not available in the browser and must be kept secret.
SUPABASE_SERVICE_ROLE_KEY=

# Cron secret used to authenticate requests from Lovable cron jobs.
# Only required if you configure scheduled jobs.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
